# Editor settings for the game code (see "Coding Rules" in .claude/CLAUDE.md): tabs shown 4 wide.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,css,html,svg}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
