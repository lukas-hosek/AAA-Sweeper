{
  "search.exclude": {
    "reference/**": true,
    ".venv/**": true,
    "out/**": true,
    "tools/tts/models/**": true
  },
  "files.watcherExclude": {
    "reference/**": true,
    ".venv/**": true,
    "out/**": true,
    "tools/tts/models/**": true
  },
  "files.exclude": {
    "**/__pycache__": true
