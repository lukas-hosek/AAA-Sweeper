{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play in Chromium (debugger)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "/usr/bin/chromium",
      "preLaunchTask": "Start dev server"
    },
    {
      "name": "Play in Chromium with test hooks (?debug)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/?debug",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "/usr/bin/chromium",
      "preLaunchTask": "Start dev server"
    }
  ]
}
